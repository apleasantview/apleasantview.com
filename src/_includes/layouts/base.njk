<!DOCTYPE html>
<html lang="{{ locale }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }} | a pleasant view</title>
	<link rel="stylesheet" href="/assets/css/index.css">
	<script defer data-domain="apleasantview.com" src="https://plausible.io/js/script.js"></script>
	<link rel="canonical" href="{{ permalink }}">
	{%- for item in collections.translations[translationKey] %}
	<link rel="alternate" hreflang="{{ item.language}}" href="{{ item.url }}">
	{%- endfor -%}
	{%- for item in collections.translations[translationKey] -%}
	{% if item.language === i18n.defaultLanguage %}
	<link rel="alternate" hreflang="x-default" href="{{ item.url }}">
	{% endif %}
	{%- endfor -%}
	<meta name="description" content="{{ description | default(i18n.languages[locale].data.description) }}">
	<meta name="color-scheme" content="light dark">
	<script type="application/ld+json">
		{
			"@context": "http://schema.org",
			"@graph": [
				{
					"@type": ["Organization", "Brand"],
					"@id": "https://www.apleasantview.com/#organization",
					"name": "a pleasant view",
					"url": "https://www.apleasantview.com",
					"description": "Website subscriptions for entrepreneurs and SMBs in Amsterdam and beyond.",
					"foundingDate": "2014-05-01",
					"slogan": "Have a pleasant view",
					"legalName": "a pleasant view",
					"sameAs": [
						"https://www.linkedin.com/company/apleasantview/",
						"https://github.com/apleasantview/",
						"https://twitter.com/apleasantview/",
						"https://www.facebook.com/apleasantview/"
					],
					"numberOfEmployees": 1,
					"founder": {
						"@type": "Person",
						"name": "Cristovao Verstraeten",
						"url": "https://www.linkedin.com/in/cverstraeten/",
						"sameAs": "https://github.com/cristovaov/"
					}
				},
				{
					"@type": "WebSite",
					"@id": "https://www.apleasantview.com/#website",
					"url": "https://www.apleasantview.com/",
					"name": "a pleasant view",
					"description": "Website subscriptions",
					"publisher": {
						"@id": "https://www.apleasantview.com/#organization"
					},
					"inLanguage": ["en", "nl", "fr"],
					"copyrightHolder": {
						"@id": "https://www.apleasantview.com/#organization"
					}
				}
			]
		}
</script>
</head>
<body>
	<header>
		<div>
			<a href="{{ permalink }}">{{ site.title }}</a>
		</div>
	</header>
	{% block content %}
		<main>
			<h1>a pleasant view</h1>
			<p>No content found.</p>
			<p>Site languages:</p>
			<ul>
				<li><a href="/en/">English</a></li>
				<li><a href="/nl/">Nederlands</a></li>
				<li><a href="/fr/">Français</a></li>
			</ul>
		</main>
	{% endblock %}
	<footer>
		<div>
			<small>
				&copy; a pleasant view 2024
			</small>
			<br>
			{# {{ site.i18n | inspect }} #}
		</div>
	</footer>
</body>
</html>
