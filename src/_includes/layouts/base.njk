<!DOCTYPE html>
<html lang="{{ language | default(_i18n.defaultLanguage) | default(site.defaultLanguage) }}">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>{{ title }} | a pleasant view</title>
	{{ "./src/assets/css/index.css" | inlinePostCSS | safe }}
	{# <link rel="stylesheet" href="/assets/css/index.css"> #}
	<link rel="preload" href="/assets/img/2-_FQp-yOr-1440.avif" as="image" fetchpriority="high">
	<script src="/assets/js/index.js" defer></script>
	<script defer data-domain="apleasantview.com" src="https://plausible.io/js/script.js"></script>
	<link rel="canonical" href="{{ permalink }}">
	{%- for item in collections.translations[translationKey] %}
	<link rel="alternate" hreflang="{{ item.language}}" href="{{ item.url }}">
	{%- endfor -%}
	{%- for item in collections.translations[translationKey] -%}
	{% if item.language === site.defaultLanguage %}
	<link rel="alternate" hreflang="x-default" href="{{ item.url }}">
	{% endif %}
	{%- endfor -%}
	<meta name="generator" content="{{ eleventy.generator }}">
	<meta name="description" content="{{ description | default(site.tagline) }}">
	<meta name="color-scheme" content="light dark">
</head>
<body>
	<div class="o-texture"></div>
	<a href="#main" class="skip-link">Skip to main content</a>
	{% include "partials/header.njk" %}
	<main id="main" tabindex="-1">
		{% block content %}
			<h1>a pleasant view</h1>
			<p>No content found.</p>
			<p>Site languages:</p>
			<ul>
				<li><a href="/en/">English</a></li>
				<li><a href="/nl/">Nederlands</a></li>
				<li><a href="/fr/">Français</a></li>
			</ul>
		{% endblock %}
	</main>
	{% include "partials/footer.njk" %}
</body>
</html>
