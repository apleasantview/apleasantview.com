{
	"name": "apleasantview.com",
	"version": "1.0.0",
	"description": "Website packages",
	"main": "index.js",
	"type": "module",
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"test": "echo \"Error: no test specified\" && exit 1",
		"start": "npm-run-all clean dev",
		"clean": "rimraf dist/",
		"dev": "npx @11ty/eleventy --serve",
		"build:eleventy": "cross-env ELEVENTY_ENV=production npx @11ty/eleventy",
		"build": "npm-run-all clean build:*",
		"dryrun": "npx @11ty/eleventy --dryrun",
		"dryrun:prod": "cross-env ELEVENTY_ENV=production npx @11ty/eleventy --dryrun",
		"lint": "eslint . --ext=js,jsx,ts,tsx",
		"lint:fix": "eslint . --ext=js,jsx,ts,tsx --fix",
		"format": "prettier . \"!.cache/**/*\" --check",
		"format:fix": "prettier . \"!.cache/**/*\" --write"
	},
	"author": "Cristovao Verstraeten",
	"license": "ISC",
	"dependencies": {
		"@11ty/eleventy": "^3.1.5",
		"@11ty/eleventy-img": "^6.0.4",
		"@apleasantview/eleventy-plugin-baseline": "^0.1.0-next.41",
		"cross-env": "^10.1.0",
		"cssnano": "^7.1.7",
		"dotenv": "^17.4.2",
		"esbuild": "0.28.0",
		"gsap": "^3.15.0",
		"lenis": "^1.3.23",
		"mouse-follower": "^1.1.2",
		"npm-run-all": "^4.1.5",
		"postcss": "^8.5.10",
		"postcss-import": "^16.1.1",
		"postcss-import-ext-glob": "^2.1.1",
		"postcss-preset-env": "^11.2.1",
		"rimraf": "^6.1.3"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.2.1",
		"globals": "^17.5.0",
		"prettier": "^3.8.3",
		"prettier-plugin-jinja-template": "^2.2.0",
		"sharp": "^0.34.5"
	}
}
